# =============================================================
# Trainer (A5000 × 4) — DDP KD 컨테이너
# =============================================================
FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3-pip \
        git wget curl ca-certificates \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && python -m pip install --upgrade pip

WORKDIR /app

COPY requirements_a5000.txt /app/
RUN pip install -r requirements_a5000.txt \
 && pip install pyyaml clip-by-openai

# 코드/설정 (compose volume으로 덮어쓰기되니 빌드 시점은 캐시용)
COPY scripts /app/scripts
COPY configs /app/configs

# 가중치 캐시/체크포인트/순환 shard 디렉토리
RUN mkdir -p /app/weights /app/checkpoints /app/working_shards

# 컨테이너는 idle로 띄워두고, docker exec로 torchrun 실행
CMD ["tail", "-f", "/dev/null"]
